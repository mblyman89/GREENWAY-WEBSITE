{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/compliance-reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/regulatory-watch",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/atm-sync",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/leafly-menu-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/leafly-ack-sweep",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/lookup-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/content-schedule",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cutover-watch",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/cron/ccrs-mail",
      "schedule": "4-59/5 * * * *"
    },
    {
      "path": "/api/cron/ach-approvals-reminder",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/ach-deadline-1pm",
      "schedule": "0 20-21/1 * * *"
    },
    {
      "path": "/api/cron/ach-funding-8am",
      "schedule": "0 15-16/1 * * *"
    },
    {
      "path": "/api/cron/ofac-screening",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/ach-bank-watch",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/cron/ach-notice-mail",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/cron/expired-quarantine",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/inbound-reconcile",
      "schedule": "7-59/15 * * * *"
    }
  ]
}
