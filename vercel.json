{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/compliance-reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/regulatory-watch",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/atm-sync",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/leafly-menu-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/leafly-ack-sweep",
      "schedule": "*/2 * * * *"
    }
  ]
}
