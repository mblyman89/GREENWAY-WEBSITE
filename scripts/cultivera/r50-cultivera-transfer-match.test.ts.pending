/**
 * tests/compliance/r50-cultivera-transfer-match.test.ts — R50 S1b.
 *
 * The store's REAL Cultivera export (normalized_cultivera/INVENTORIES_NORMALIZED.xlsx)
 * married to the store's REAL inbound transfers (normalized_cultivera/TRANSFERS_INDEX.json,
 * built by scripts/cultivera/build-transfer-index.py from the read-only back-office
 * harvest of 2026-10-12), through the same path the reconstruct executor uses.
 *
 * Three independent checks:
 *   1. Every count the bible §1.9 records is pinned.
 *   2. The per-lot answer equals a SHA-256 computed by an independent Python
 *      implementation of the rule (/workspace/r50/s1b/oracle.py at build time;
 *      it reads Cultivera's raw JSON, not this repo's parsers).
 *   3. A plain-TypeScript re-statement of the rule here agrees lot by lot.
 */
import { describe, it, expect } from "vitest";
import * as fs from "node:fs";
import * as crypto from "node:crypto";
import * as XLSX from "xlsx";
import { transformWorkbooks } from "@/lib/pos/transform";
import { planCultiveraManifests, type CultiveraGroupRow } from "@/lib/inventory/cultivera-manifest-group-core";
import {
  planTransferManifests,
  buildTransferLineage,
  transferDedupeKey,
  __runCultiveraTransferMatchCoreTests,
  type TransferIndexEntry,
} from "@/lib/inventory/cultivera-transfer-match-core";
import { isMigrationManifest, isReconstructedManifest } from "@/lib/inventory/cultivera-manifest-group-core";

const INV = "normalized_cultivera/INVENTORIES_NORMALIZED.xlsx";
const PROD = "normalized_cultivera/PRODUCTS_NORMALIZED.xlsx";
const IDX = "normalized_cultivera/TRANSFERS_INDEX.json";
const TODAY = "2026-10-12";

function productsBuffer(): Buffer {
  const wb = XLSX.read(fs.readFileSync(PROD));
  const rows = XLSX.utils
    .sheet_to_json<Record<string, unknown>>(wb.Sheets[wb.SheetNames[0]], { defval: "" })
    .map((r) => ({ ...r, Description: "" }));
  const out = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(out, XLSX.utils.json_to_sheet(rows), "Sheet1");
  return XLSX.write(out, { type: "buffer", bookType: "xlsx" }) as Buffer;
}

const sources = transformWorkbooks({
  productsBuffer: productsBuffer(),
  inventoriesBuffer: fs.readFileSync(INV),
  productsSheet: "Sheet1",
  inventoriesSheet: "Inventories",
}).lotSources;
const rows: CultiveraGroupRow[] = sources.map((s) => ({
  barcode: s.barcode,
  vendor: s.vendor,
  receivedDateRaw: s.receivedDateRaw,
  units: s.units,
  productName: s.productName,
}));
const index = JSON.parse(fs.readFileSync(IDX, "utf8")) as { sourceSha256: string; transfers: TransferIndexEntry[] };
const transfers = index.transfers;
const plan = planTransferManifests(rows, transfers, { pacificToday: TODAY });

describe("R50 S1b: real lots married to real Cultivera transfers", () => {
  it("self-tests pass", () => {
    expect(__runCultiveraTransferMatchCoreTests().passed).toBeGreaterThanOrEqual(72);
  });

  it("reads the committed index (guards the test itself)", () => {
    expect(transfers.length).toBe(1164);
    expect(transfers.reduce((n, t) => n + t.lines.length, 0)).toBe(26095);
    expect(new Set(transfers.map((t) => t.id)).size).toBe(1164);
    expect(transfers.filter((t) => !t.acceptedAt).length).toBe(6);
    expect(index.sourceSha256).toMatch(/^[0-9a-f]{64}$/);
    // The public index carries no money, addresses or people.
    const text = fs.readFileSync(IDX, "utf8");
    for (const banned of ["UnitPrice", "TotalPrice", "Total\"", "Address", "AcceptedBy", "Employee", "JsonFile", "Bearer"]) {
      expect(text.includes(banned), banned).toBe(false);
    }
  });

  it("pins the bible §1.9 numbers", () => {
    expect(plan.summary.lots).toBe(4256);
    expect(plan.summary.matched).toBe(3987);
    expect(plan.summary.matchedOnlyReceipt).toBe(3738);
    expect(plan.summary.matchedFirstAfter).toBe(249);
    expect(plan.summary.unmatched).toEqual({
      no_receipt: 269,
      ambiguous_no_time: 0,
      ambiguous_none_after: 0,
      ambiguous_tie: 0,
      vendor_mismatch: 0,
    });
    expect(plan.summary.transfersUsed).toBe(651);
    expect(plan.summary.fallbackGroups).toBe(53);
    expect(plan.fallbackGroups.every((g) => g.kind === "undated")).toBe(true);
    expect(plan.numberCollisions).toEqual([]);
  });

  it("equals the independent Python oracle, lot by lot (SHA-256 of barcode=transferId)", () => {
    const answer = new Map<string, string>();
    for (const d of plan.decisions) answer.set(d.barcode, d.matched ? String(d.transferId) : "-");
    const text = [...answer.keys()]
      .sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
      .map((b) => `${b}=${answer.get(b)}`)
      .join("\n");
    expect(answer.size).toBe(4256);
    expect(crypto.createHash("sha256").update(text).digest("hex")).toBe(
      "54b67ffcf0c242739deb6cb3c4e703dcca7980760c03ac74ae599711d8a180a3",
    );
  });

  it("agrees with a plain re-statement of the rule written here", () => {
    const acc = new Map<number, number>();
    for (const t of transfers) if (t.acceptedAt) acc.set(t.id, Date.parse(t.acceptedAt));
    const rec = new Map<string, number[]>();
    for (const t of transfers) {
      if (!acc.has(t.id)) continue;
      for (const [bc, q] of t.lines) if (q > 0) rec.set(bc, [...new Set([...(rec.get(bc) ?? []), t.id])]);
    }
    let disagreements = 0;
    for (const d of plan.decisions) {
      const ids = rec.get(d.barcode) ?? [];
      if (ids.length === 0) {
        if (d.matched) disagreements++;
        continue;
      }
      if (ids.length === 1) {
        if (!d.matched || d.transferId !== ids[0]) disagreements++;
        continue;
      }
      expect(d.matched, d.barcode).toBe(true);
      if (d.matched) {
        // the pick is a receipt, and no other receipt is between received and the pick
        expect(ids).toContain(d.transferId);
        expect(d.evidence).toBe("first_receipt_after_received");
      }
    }
    expect(disagreements).toBe(0);
  });

  it("is a partition: every lot on exactly one manifest, vendors never mixed", () => {
    const all = [...plan.transferGroups.flatMap((g) => g.barcodes), ...plan.fallbackGroups.flatMap((g) => g.barcodes)];
    expect(all.length).toBe(4256);
    expect(new Set(all).size).toBe(4256);
    const vendorOf = new Map<string, string>();
    for (const s of sources) if (!vendorOf.has(s.barcode)) vendorOf.set(s.barcode, s.vendor.replace(/\s+/g, " ").trim().toUpperCase());
    for (const g of plan.transferGroups) for (const b of g.barcodes) expect(vendorOf.get(b), b).toBe(g.vendorKey);
  });

  it("S1's time grouping already agreed with the real transfers (cross-validation of both)", () => {
    const s1 = planCultiveraManifests(rows, { pacificToday: TODAY });
    const tOf = new Map<string, number>();
    for (const d of plan.decisions) if (d.matched) tOf.set(d.barcode, d.transferId);
    let pure = 0;
    let mixed = 0;
    for (const g of s1.groups.filter((x) => x.kind === "session")) {
      const ts = new Set(g.barcodes.map((b) => tOf.get(b)));
      if (ts.size === 1) pure++;
      else mixed++;
    }
    // 647 of 649 sessions are exactly one real transfer. The 2 mixed are two REAL manifests from one vendor
    // received minutes apart, which time alone cannot separate (this is why S1b exists):
    //   EDGEMONT GROUP LLC 2026-03-31 (transfers 883 + 884, lots received 13 s apart)
    //   GROW OP FARMS 2025-11-26     (transfers 682 + 683, lots received 97 s apart)
    expect(pure).toBe(647);
    expect(mixed).toBe(2);
    expect(s1.summary.sessionGroups).toBe(649);
    // The other direction: a real transfer split across two S1 sessions never happens.
    const sessionsOf = new Map<number, Set<string>>();
    for (const g of s1.groups.filter((x) => x.kind === "session"))
      for (const b of g.barcodes) {
        const t = tOf.get(b)!;
        sessionsOf.set(t, (sessionsOf.get(t) ?? new Set()).add(g.key));
      }
    expect([...sessionsOf.values()].filter((s) => s.size > 1).length).toBe(0);
  });

  it("real numbers kept verbatim; one odd number recorded honestly", () => {
    const nums = plan.transferGroups.map((g) => g.manifestNumber);
    expect(new Set(nums).size).toBe(651);
    expect(nums.filter((n) => !/^[A-Za-z0-9._-]+$/.test(n))).toEqual(["inv02211$inv02182"]);
    expect(plan.transferGroups.every((g) => !g.manifestNumber.startsWith("CV-"))).toBe(true);
    expect(new Set(plan.transferGroups.map((g) => g.status))).toEqual(new Set(["Accepted", "Partially Accepted"]));
  });

  it("lineage keeps the accounting exclusion and a non-colliding dedupe key", () => {
    const g = plan.transferGroups[0];
    const lin = buildTransferLineage({ importId: "imp", sourceManifestId: "m", sourceManifestNumber: "POS-IMPORT-x", group: g });
    const manifest = { manifest_number: g.manifestNumber, raw_payload: lin };
    expect(isReconstructedManifest(manifest)).toBe(true);
    expect(isMigrationManifest(manifest)).toBe(true);
    expect(transferDedupeKey("imp", g).endsWith("|IMPORT-imp")).toBe(true);
    const keys = plan.transferGroups.map((x) => transferDedupeKey("imp", x));
    expect(new Set(keys).size).toBe(keys.length);
  });
});
