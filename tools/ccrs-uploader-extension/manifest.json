{
  "manifest_version": 3,
  "name": "Greenway CCRS Uploader",
  "version": "1.1.0",
  "description": "Uploads Greenway's CCRS files through the CCRS web page you are logged in to, one group at a time, as the Greenway back office directs. Never sees your password.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://cannabisreporting.lcb.wa.gov/*",
    "https://precannabisreporting.lcb.wa.gov/*",
    "https://www.greenwaymarijuana.com/*",
    "https://greenwaymarijuana.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://cannabisreporting.lcb.wa.gov/*", "https://precannabisreporting.lcb.wa.gov/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Greenway CCRS Uploader", "default_popup": "popup.html" },
  "options_page": "options.html"
}
