{
  "name": "greenway-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=7168 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:vendors": "tsx scripts/seed/seed_vendors_brands.ts",
    "seed:vendors:cultivera": "tsx scripts/seed/seed_vendors_from_cultivera.ts",
    "test": "vitest run",
    "test:compliance": "vitest run tests/compliance",
    "announcer:sync": "node scripts/announcer/sync-served-copy.mjs",
    "announcer:check": "node scripts/announcer/sync-served-copy.mjs --check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "register:build": "vite build --config register-app/vite.config.ts",
    "register:preflight:ios": "tsx scripts/pos/preflight-ios-build.ts",
    "register:build:ios": "npm run register:preflight:ios && vite build --config register-app/vite.config.ts && cap sync ios",
    "register:dev": "vite --config register-app/vite.config.ts",
    "register:preview": "vite preview --config register-app/vite.config.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/web-push": "3.6.4",
    "@vercel/speed-insights": "^2.0.0",
    "exceljs": "^4.4.0",
    "next": "16.2.9",
    "plaid": "^45.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.9.0",
    "sharp": "^0.34.5",
    "unpdf": "^1.6.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
