# Greenway crawler — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env (it's gitignored).

# --- Environment ----------------------------------------------------------------
# Set to "production" on the real deployment. Production HARD-REQUIRES
# CRAWL_ALLOW_DOMAINS below (S-5): the worker refuses to start (and refuses every
# fetch) without an explicit allow-list, so it can only ever research
# pre-approved hosts. Leave as "development" for local testing.
CRAWLER_ENV=development

# --- Auth between the Next.js site and this worker -----------------------------
# A long random shared secret. The site sends it as `X-Crawler-Secret`; the
# worker rejects any request without the exact match. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
CRAWLER_SHARED_SECRET=change-me-to-a-long-random-string

# --- Supabase (the worker writes drafts directly to ai_suggestions) ------------
# Use the SERVICE ROLE key (server-side only — this worker is not public).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (OpenAI-compatible; same values as the site) ------------------
# Leave AI_API_KEY empty to run the pipeline WITHOUT the LLM step (CSS-first
# extraction still works and is often enough). When set, the schema-extraction
# step is enabled.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- Crawl politeness ----------------------------------------------------------
# Per-domain minimum delay (seconds) and a global cache TTL (seconds).
CRAWL_MIN_DELAY_SECONDS=2.0
CRAWL_CACHE_TTL_SECONDS=86400

# Deep research: total pages read per research request. The frontier crawl
# (C2) walks the WHOLE site — every fetched page's own links join the queue —
# until this budget is spent. Each fetch honors robots.txt + the per-domain
# delay, so a full crawl deliberately takes several minutes on a big site.
# 25 is the default; raise toward 60-120 for very large vendor catalogs.
CRAWL_MAX_PAGES=25

# --- Dynamic-content capture (C3) -----------------------------------------------
# When true (default) the browser fetch scrolls the FULL page so lazy-loaded
# sections/images render, waits for images, removes cookie/newsletter overlays,
# and best-effort clicks visible "load more / show more / view all" buttons
# before capturing HTML. Features the installed crawl4ai doesn't support are
# skipped automatically. Set false for the fastest plain page-load capture.
CRAWL_DYNAMIC_CONTENT=true
# Pause between scroll steps (seconds) and settle time before the HTML snapshot.
CRAWL_SCROLL_DELAY_SECONDS=0.3
CRAWL_SETTLE_SECONDS=2.0
# Per-page browser timeout (seconds) — generous for image-heavy catalog pages.
CRAWL_PAGE_TIMEOUT_SECONDS=90
# A descriptive UA so site owners can identify/contact us. Include a real email.
CRAWL_USER_AGENT=GreenwayBot/1.0 (+https://greenwaymarijuana.com; contact: web@greenwaymarijuana.com)
# Respect robots.txt (true in production; can disable for local testing only).
CRAWL_RESPECT_ROBOTS=true

# --- Crawl hardening (DF-7) ----------------------------------------------------
# Send a realistic, rotating modern-browser User-Agent + full browser headers so
# public pages serve the same content a human visitor sees. This is parity with a
# normal browser, NOT evasion of an anti-bot system. Set false to always send the
# bare CRAWL_USER_AGENT above.
CRAWL_REALISTIC_HEADERS=true
# Retry transient failures (429/5xx/network) with exponential backoff + jitter,
# honoring a server's Retry-After header.
CRAWL_MAX_RETRIES=3
CRAWL_BACKOFF_BASE_SECONDS=1.5
CRAWL_BACKOFF_MAX_SECONDS=30
# Optional transparent egress proxy (e.g. a reputable commercial proxy used at
# polite rates). Leave empty for none. Standard HTTP_PROXY/HTTPS_PROXY also work.
CRAWL_PROXY_URL=
# Per-domain allow-list (comma-separated hostnames). In development an empty
# value allows any host a staff member submits. In PRODUCTION (CRAWLER_ENV=
# production) this is REQUIRED — the worker refuses to start without it (S-5).
# Set it to the brands you actually carry, e.g.:
#   CRAWL_ALLOW_DOMAINS=goodbrand.com,otherbrand.com
CRAWL_ALLOW_DOMAINS=

# --- Social: Meta Graph API (DF-9, sanctioned) ---------------------------------
# The legitimate way to read vendors' PUBLIC Instagram content: you authenticate
# as Greenway (your own Page + IG Business account) and use Instagram Business
# Discovery. These are ACCESS TOKENS generated in the Meta developer console —
# NEVER passwords. Leave empty to disable social features. See docs/SOCIAL_SETUP.md.
META_GRAPH_TOKEN=
META_IG_BUSINESS_ID=
META_GRAPH_VERSION=v21.0

# --- Cultivera Market: authenticated vendor-menu fetch (CV-2) ------------------
# You are a real Cultivera Market BUYER and your rep approved pulling vendor
# menus into the back office this way. The worker logs in ONCE with your OWN
# marketplace credentials, caches the session, reuses it, re-logs on a 401, and
# then calls Cultivera's JSON API politely (slow, human-paced) to fetch a
# vendor's live menu (products, descriptions, images, potency/COA, logos).
# These are your marketplace login credentials — NOT an API key. Leave empty to
# keep all Cultivera features disabled.
CULTIVERA_EMAIL=
CULTIVERA_PASSWORD=
# The marketplace site your browser logs into (region-specific). The API base is
# auto-discovered from the app at runtime; only override it below if you must.
CULTIVERA_SITE_URL=https://wa.cultiveramarket.com
# Optional explicit API base (no trailing slash). Empty = auto-detect from the app.
CULTIVERA_API_BASE=
# Politeness: seconds to pause BEFORE each authenticated request (jittered up to
# +50%). The owner wants polite, respectful traffic — not stealth. Raise to slow
# down further.
CULTIVERA_MIN_DELAY_SECONDS=3
# How long a cached session is trusted before a proactive re-login (seconds). A
# 401 always forces a re-login regardless. Default 45 minutes.
CULTIVERA_SESSION_TTL_SECONDS=2700
# Where the cached session lives (relative to crawler/). Under .cache/ so it is
# already gitignored. Contains a live token — never commit it.
CULTIVERA_SESSION_FILE=.cache/cultivera_session.json

# --- Service ------------------------------------------------------------------
CRAWLER_PORT=8200
# Where on-disk caches/logs live (relative to the crawler/ folder).
CRAWL_CACHE_DIR=.cache
