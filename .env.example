# Greenway Marijuana — environment variables (copy to .env.local and fill in)
# All NEXT_PUBLIC_* values are exposed to the browser.

# --- Analytics (optional) ---------------------------------------------------
# Google Analytics 4 measurement ID. When unset, analytics is fully disabled
# (no scripts loaded, no tracking). Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# --- Leafly Menu Integration API v2.0 (optional) ----------------------------
# Finding L-16. This block previously documented LEAFLY_API_BASE_URL and
# LEAFLY_API_KEY. NEITHER OF THOSE IS READ BY ANY CODE IN THIS REPOSITORY --
# they are v1-era names, and setting them does nothing at all. The four
# variables below are the real ones, read by src/lib/leafly/config.ts:22-28.
# Anyone who filled in the old two and expected Leafly to work was silently
# misled, which is why they have been deleted rather than left as aliases.
#
# You do NOT have to use environment variables. The back office
# (Admin -> Integrations -> Credentials) writes the same four values to the
# integration_credentials table, and a non-empty database value OVERRIDES the
# environment value (see the header comment in config.ts). Env vars are the
# better choice on Vercel; the back office is the better choice for the owner.
#
# Base URLs and OAuth token URLs are NOT configurable and are not listed here.
# They are derived from LEAFLY_ENVIRONMENT in config.ts:49-61 and verified
# against the vendored live spec (docs/leafly-specs/). Hard-coding them was a
# deliberate decision: a typo'd base URL is indistinguishable from an outage.
#
# Which Leafly environment to talk to. Anything other than the exact string
# "production" is treated as "sandbox" -- fail-safe, so a typo cannot
# accidentally push your live menu. Leave it unset until you are certified.
#   sandbox    -> api-sandbox.leafly.io  + sso-sandbox.leafly.io
#   production -> api.leafly.com         + sso.leafly.com
LEAFLY_ENVIRONMENT=sandbox
#
# The per-dispensary menu key, taken from the integration URL Leafly gives you
# (biz-sandbox.leafly.io/retailers/<id>/menu). In Leafly's sandbox email this
# is called the "Dispensary Menu Key".
#
# THIS KEY IS PER-ENVIRONMENT. The sandbox key will NOT work in production and
# vice versa; the symptom is HTTP 404 on every call, not 403.
#
# It is also NOT the order integration key. Leafly issues a separate
# orderIntegrationKey for the Order API, and assuming the two are the same
# value is a documented trap (see leafly-recon/LEAFLY-SANDBOX-READINESS-REPORT.md).
LEAFLY_MENU_INTEGRATION_KEY=
#
# OAuth2 client-credentials pair. Sent as HTTP Basic to the token URL, which
# returns a bearer token cached in-process until ~30s before it expires.
# Both must be set: the app treats a half-configured pair as not configured.
LEAFLY_CLIENT_ID=
LEAFLY_CLIENT_SECRET=
#
# NOT AN ENVIRONMENT VARIABLE YET: Leafly also issues an HMAC key, used to
# verify INBOUND order webhooks. Nothing reads it today. It arrives with the
# order integration in slice L-5, where it belongs in the database's encrypted
# credential columns rather than here. Listed so its absence is understood as
# a known state and not a missing setting.

# --- Loyalty email (optional) -----------------------------------------------
# Resend API key used to deliver loyalty sign-up confirmations. When unset,
# sign-ups are accepted but no email is sent.
RESEND_API_KEY=
LOYALTY_FROM_EMAIL=

# --- Newsletter engagement stats webhooks (Slice 50) ------------------------
# The newsletter statistics suite (Customers report tab) ingests open/click/
# bounce/spam events from your email provider via signature-verified webhooks.
# Provider-agnostic: wire Resend (current sender) and/or SendGrid.
#
# Resend: add a webhook in resend.com/webhooks pointing at
#   https://<your-domain>/api/webhooks/resend
# and paste its signing secret (starts with whsec_) here. When unset, the
# endpoint accepts events WITHOUT verification (dev only — always set in prod).
RESEND_WEBHOOK_SECRET=
#
# SendGrid: enable the Signed Event Webhook pointing at
#   https://<your-domain>/api/webhooks/sendgrid
# and paste the verification PUBLIC KEY (base64 DER or PEM) here.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# ── Inbound vendor_intake@ email (Slice 99) ─────────────────────────────────
# One endpoint receives the vendor_intake@ mailbox: POST /api/webhooks/inbound-email
# Pick the provider that forwards mail to us (default: resend). SendGrid is a
# drop-in later — set these two envs + point the Parse MX/webhook URL here, no
# code change.
INBOUND_EMAIL_PROVIDER=resend
# The intake mailbox. Match is exact OR by local-part (so "vendor_intake" works
# across your own domain). Mail to anything else is logged and ignored.
VENDOR_INTAKE_MAILBOX=vendor_intake
# Resend Inbound signing secret (Svix, starts with whsec_). Falls back to
# RESEND_WEBHOOK_SECRET when unset. When BOTH are unset, verification is skipped
# (dev only — always set in prod).
RESEND_INBOUND_SECRET=
# SendGrid Inbound Parse cannot sign requests, so authenticate with a shared
# secret placed in the webhook URL as ?token=... (or x-inbound-token header).
# Set this to any long random string and use the same value in the Parse URL.
SENDGRID_INBOUND_TOKEN=

# Order notifications (Slice 7). When ORDER_EMAIL_FROM is unset, order emails
# are skipped (orders still save). ORDER_STAFF_EMAILS is a comma-separated list
# of staff recipients alerted on every new pickup order.
ORDER_EMAIL_FROM=
ORDER_STAFF_EMAILS=

# --- Secrets at rest (Roadmap S-10) -----------------------------------------
# When set, sensitive columns (employee bank routing/account numbers, company
# ACH account, integration API secrets) are AES-256-GCM encrypted before they
# are written to the database ("encv1:" envelope) and transparently decrypted
# on read. Legacy plaintext rows keep working and are re-encrypted the next
# time they are saved. Use any long random string (32+ chars); the actual key
# is derived via SHA-256. Rotating the key makes previously encrypted values
# unreadable, so treat it like a database credential and back it up. When
# unset, values are stored in plaintext and the admin dashboard shows a
# warning banner. Staff clock PINs are salted-scrypt hashed regardless of
# this setting.
DATA_ENCRYPTION_KEY=

# --- Supabase (back office) -------------------------------------------------
# Project URL and anon key are safe for the browser. The service-role key is
# SERVER-ONLY — never expose it to the client. Get these from your Supabase
# project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails auto-promoted to the "owner" role on first
# login (bootstrap admins). Example: you@greenwaymarijuana.com
ADMIN_BOOTSTRAP_EMAILS=

# --- AI Enrichment Engine (optional) ----------------------------------------
# When no AI key is set, AI features soft-disable (buttons hidden) and the rest
# of the back office works normally. AI output is always a DRAFT a staff member
# must Accept before it reaches the public site (compliance-gated).
#
# EITHER name works for the key — set just one:
#   OPENAI_API_KEY   (standard OpenAI name — easiest if you already have it)
#   AI_API_KEY       (generic name; takes priority if both are set)
#
# Defaults: model = gpt-4o-mini, base URL = https://api.openai.com/v1.
# Override the model/endpoint to use any OpenAI-compatible provider
# (OpenRouter, Together, a local gateway, etc.). AI_* names win over OPENAI_*.
OPENAI_API_KEY=
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_VISION_MODEL=gpt-4o-mini
#
# Heavy tier + the AI product/strain lookup on Product Onboarding (T-314).
# AI_MODEL_HEAVY (or OPENAI_MODEL_HEAVY) is the strong model. It is used by the
# router's "heavy" tier and is PINNED by the live web-search lookup
# (src/lib/ai/provider.ts generateWebSearch). Default: gpt-4o.
#   - If the id starts with "gemini" (e.g. a Gemini 3 model), the lookup uses
#     Google's google_search grounding (native Interactions API) instead of the
#     OpenAI web_search tool.
#   - AI_GEMINI_API_KEY is the Google key for that path; when unset it falls
#     back to AI_API_KEY / OPENAI_API_KEY, so one key can cover both.
#   - AI_GEMINI_BASE_URL overrides the Interactions endpoint
#     (default https://generativelanguage.googleapis.com/v1beta/interactions);
#     AI_GEMINI_OPENAI_BASE_URL overrides the built-in-knowledge fallback
#     (default https://generativelanguage.googleapis.com/v1beta/openai).
#   - AI_THINKING_LEVEL sets Gemini's thinking level for the lookup
#     (default "low" - the latency-minimising setting).
#   - AI_WEBSEARCH_TIMEOUT_MS is how long one lookup HTTP call may run before
#     we abort it with a friendly "took too long" message. Default 290000
#     (290s). Keep it BELOW the drafts page's maxDuration (300s) or Vercel kills
#     the function first and the browser shows a generic error.
# AI_MODEL_HEAVY=gpt-4o
# AI_GEMINI_API_KEY=
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/interactions
# AI_GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_THINKING_LEVEL=low
# AI_WEBSEARCH_TIMEOUT_MS=290000
#
# SLICE S06 - structured AI lookup. The lookup asks for every fact in its own
# field with its own confidence (0-100) and sources, and shows each field's
# band (Auto >= 90 / Review / Low / Unknown), grounded citations, and Google's
# Search Suggestions (display only, never stored). ON by default. Set to off
# (or 0 / false / no / disabled) to roll back to the pre-S06 prompt, shape and
# token cap, byte-identical, without a deploy.
# LOOKUP_SCHEMA_V2=on
#
# SLICE S05 - stamp product identity at the receiving door (parser -> lot ->
# draft -> kb_products link). ON by default. Set to off (or 0 / false / no /
# disabled) to stop stamping identity_key / kb_product_id on new lots and
# drafts without a deploy. Needs migration 0234 for the columns to exist.
# INTAKE_IDENTITY_STAMP=on
#
# SLICE S10 - the per-field 90% auto-attach policy (fact-attach-policy-core).
#   0 / off = nothing computed or logged (rollback)
#   1       = SHADOW (default): every lookup computes what WOULD be attached,
#             shows a preview, and logs counts for the Product Onboarding
#             footer. Writes NOTHING.
#   2       = act, behind this flag  3 = act, default on.
# Rings 2 and 3 only write once the single write door (S07) ships; until then
# they behave exactly like 1 and the footer says so.
# ATTACH_POLICY_RING=1
#
# SLICE S17 - one menu version per approve batch. ON by default: the focused
# delivery on Product Onboarding shows "Approve all N priced" (every gate still
# runs; the menu updates once), and a single Approve within 20 s of the last
# one replaces that still-unpublished update instead of adding another. Set to
# off (or 0 / false / no / disabled) to roll back without a deploy.
# INTAKE_BATCH_STAGING=on
#
# SLICE S18 - the Cultivera cutover guard: publish Cultivera first, then
# receive. ON by default: while a real (not Test-mode) Cultivera upload is
# staged, receiving updates wait instead of publishing, and publishing the
# upload rebuilds them on top of it. After cutover a second real upload is
# refused. Runbook: docs/CULTIVERA_CUTOVER_RUNBOOK.md. Set to off (or 0 /
# false / no / disabled) to roll back without a deploy.
# INTAKE_CUTOVER_GUARD=on
#
# SLICE S19 - vendor-id identity for restock merge + the "will join live card"
# preview. ON by default: a restock whose vendor name is spelled differently
# still joins the live card when both lots point at the same vendor record
# (gap-fill only - a name match always stands), and Product Onboarding shows
# what Approve will do on each row of the picked delivery. Set to off (or 0 /
# false / no / disabled) to roll back to the name rule without a deploy.
# INTAKE_VENDOR_ID_IDENTITY=on
#
# Spend controls (src/lib/ai/router.ts). AI_MODE is "maintenance" (default -
# heavy tasks downshift to AI_MODEL) or "sprint" (heavy tasks use
# AI_MODEL_HEAVY). Budgets are hard caps per calendar month; 0 = no cap. The
# per-1K prices feed the $ estimate on Admin -> AI Usage.
# AI_MODE=maintenance
# AI_MONTHLY_TOKEN_BUDGET=0
# AI_MONTHLY_USD_BUDGET=0
# AI_PRICE_PER_1K_PROMPT=0
# AI_PRICE_PER_1K_COMPLETION=0

# --- Crawler worker (optional, DF-6) ----------------------------------------
# The "Research with the crawler" buttons (on each vendor/brand) call a separate
# Python crawl4ai worker that reads a real page and writes grounded DRAFTS to the
# review queue (verified against the source + compliance-gated). When these are
# unset, the crawler buttons soft-disable and everything else works normally.
# Deploy the worker from /crawler (see crawler/docs/RUNBOOK.md), then set:
#   CRAWLER_BASE_URL      e.g. https://crawler.your-host.com  (no trailing slash)
#   CRAWLER_SHARED_SECRET must match the worker's CRAWLER_SHARED_SECRET exactly
CRAWLER_BASE_URL=
CRAWLER_SHARED_SECRET=

# --- Compliance deadline reminders (Task W) ----------------------------------
# Daily cron (/api/cron/compliance-reminders, scheduled in vercel.json) sends
# CCRS weekly-upload + monthly LIQ-1295 deadline reminders by email and Web
# Push. Email uses the existing RESEND_API_KEY + ORDER_EMAIL_FROM +
# ORDER_STAFF_EMAILS. Both channels are optional; whichever is configured is
# used, and nothing breaks when unset.
#
# Vercel Cron authenticates with `Authorization: Bearer ${CRON_SECRET}`.
# In production an UNSET CRON_SECRET makes the endpoint refuse unauthenticated
# calls (fail closed); set any long random string here AND in Vercel env.
CRON_SECRET=
# Web Push (VAPID) keys — generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:). Defaults to the store site.
VAPID_SUBJECT=
